# ========================================================
# CONFIGURACIÓN HOSTINGER - GUIANZAPP PWA (REACT SPA)
# ========================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forzar HTTPS seguro (Requisito estricto de PWA)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. No reescribir si el archivo o carpeta existe físicamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Redirección SPA: enviar todas las demás peticiones a index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ========================================================
# CABECERAS Y TIPOS MIME PARA SERVICE WORKERS Y PWA
# ========================================================
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/manifest+json .json
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  # Service Worker NUNCA debe ser cacheado (permite actualizaciones inmediatas)
  <FilesMatch "(sw\.js|registerSW\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Manifiesto PWA
  <FilesMatch "manifest\.webmanifest$">
    Header set Content-Type "application/manifest+json; charset=utf-8"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Activos estáticos cacheados con hash (JS, CSS, imágenes)
  <FilesMatch "\.(js|css|png|jpg|jpeg|svg|webp|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ========================================================
# SEGURIDAD Y COMPRESIÓN
# ========================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/manifest+json
</IfModule>

# Deshabilitar listado de directorios
Options -Indexes
